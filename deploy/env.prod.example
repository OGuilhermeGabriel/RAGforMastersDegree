# Django / API (Produção na EC2)
DEBUG=False
DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-forte
ALLOWED_HOSTS=apirag.guilhermegabriel.grupo-05.sd.ufersa.dev.br,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://guilhermegabriel.grupo-05.sd.ufersa.dev.br

# JWT
JWT_SECRET_KEY=gere-outra-chave-jwt-aleatoria-forte
JWT_EXPIRATION_HOURS=24

# Amazon RDS (PostgreSQL + pgvector)
DB_NAME=rag_db
DB_USER=postgres
DB_PASSWORD=senha-forte-do-rds
DB_HOST=SEU-ENDPOINT.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_SSLMODE=require

# Amazon S3 (Bucket privado para PDFs)
# Se a EC2 usar o IAM Instance Profile 'LabInstanceProfile', boto3 autentica automaticamente.
# Caso contrário, adicione AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY e AWS_SESSION_TOKEN.
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=seu-bucket-privado-rag-ufersa

# Google Gemini API
GEMINI_API_KEY=cole-sua-chave-gemini-aqui
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
