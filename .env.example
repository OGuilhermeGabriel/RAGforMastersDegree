# Django / API
DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-segura
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# JWT
JWT_SECRET_KEY=troque-por-outra-chave-jwt-segura
JWT_EXPIRATION_HOURS=24

# Banco de Dados (local via Docker Compose; em produção será o RDS)
DB_NAME=rag_db
DB_USER=rag_user
DB_PASSWORD=rag_password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Armazenamento de PDFs ('local' em desenvolvimento, 's3' na AWS)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/app/storage
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Google Gemini API
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite